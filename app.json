{
  "expo": {
    "name": "破风",
    "slug": "breakwind-app",
    "version": "0.1.0",
    "scheme": "breakwind-dev",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./public/icon-512.png",
    "ios": {
      "bundleIdentifier": "com.breakwind.running.dev",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": false
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-sharing",
      "./plugins/with-launch-scope.cjs"
    ]
  }
}
