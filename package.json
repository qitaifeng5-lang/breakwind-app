{
  "name": "breakwind-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "native/index.js",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "mobile:start": "expo start --dev-client",
    "mobile:ios": "expo run:ios --device",
    "mobile:bundle": "expo export --platform ios",
    "test:browser": "playwright test",
    "check:integrity": "node scripts/check-project.mjs integrity",
    "check:syntax": "node scripts/check-project.mjs syntax",
    "check:ios": "node scripts/check-project.mjs ios",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "16.2.0",
    "expo": "56.0.24",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-location": "~56.0.26",
    "expo-sqlite": "~56.0.6",
    "expo-task-manager": "~56.0.27",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.37.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "9.39.1",
    "globals": "16.5.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.6"
    }
  }
}
